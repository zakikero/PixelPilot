# Keep non-secret application settings in config.yaml.
# Add deployment-specific secrets here when they are needed.

# Optional logging override:
# LOG_LEVEL=DEBUG

# Optional ICE servers for SmallWebRTC across different networks. Localhost
# connections do not need these. Use your own TURN credentials when required.
# PIPECAT_ICE_SERVERS='[{"urls":"stun:stun.example.com:3478"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"secret"}]'
