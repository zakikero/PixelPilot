# Offline/local voice pipeline

# transport: local audio
AUDIO_INPUT_DEVICE_INDEX=1

# Speech-to-text: faster-whisper via Pipecat
WHISPER_MODEL_SIZE=tiny
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_CPU_THREADS=4

# Text-to-speech: Piper
PIPER_MODEL_NAME=en_US-amy-medium
PIPER_VOICE_ID=amy

# Local language model: Ollama offline
OLLAMA_MODEL=llama3
OLLAMA_HOST=http://localhost:11434

